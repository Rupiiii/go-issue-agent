+func TestRequiredBoolErrorMessage(t *testing.T) {
+	validate := New()
+
+	type Test struct {
+		BoolValue  bool `validate:"required"`
+		IntValue   int  `validate:"required"`
+		PtrValue   *bool
+		TrueValue  bool
+		FalseValue bool
+	}
+
+	var test Test
+	test.TrueValue = true
+	test.FalseValue = false
+
+	err := validate.Struct(test)
+	NotEqual(t, err, nil)
+
+	errs := err.(ValidationErrors)
+	Equal(t, len(errs), 2)
+
+	// Test for new error message on bool
+	fe := getError(errs, "Test.BoolValue", "Test.BoolValue")
+	NotEqual(t, fe, nil)
+	Equal(t, fe.Error(), "Key: 'Test.BoolValue' Error:Field validation for 'BoolValue' failed on the 'required' tag (note: for booleans, 'false' is considered a zero value)")
+
+	// Test for original error message on other types
+	fe = getError(errs, "Test.IntValue", "Test.IntValue")
+	NotEqual(t, fe, nil)
+	Equal(t, fe.Error(), "Key: 'Test.IntValue' Error:Field validation for 'IntValue' failed on the 'required' tag")
+}
