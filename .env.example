# Copy this file to .env and fill in your credentials.
# The required LLM key depends on `provider` in config/settings.yaml.

# Google AI Studio (Gemini) — default provider. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Anthropic API key — only needed if provider is set to "anthropic".
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# GitHub personal access token (read access to public repos is enough) —
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...
